---
import Portfolio from '../../layouts/Portfolio.astro';
import { portfolioBySlug } from '../../data/portfolio';
import bodyHtml from '../../portfolio-bodies/ethereum.html?raw';

const project = portfolioBySlug('ethereum')!;
const body = bodyHtml
  .replaceAll('{{ page.content_template }}', project.slug)
  .replaceAll('{{site.url}}', '')
  .replaceAll('{{ site.url }}', '');
---

<Portfolio project={project}>
  <Fragment set:html={body} />
</Portfolio>
